{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Redis": "localhost:6379,abortConnect=false" },
  "Kafka": { "BootstrapServers": "localhost:9092", "Topic": "fundoo.note-events" },
  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "ExpiryMinutes": 30
  }
}
