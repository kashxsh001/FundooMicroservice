{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Notes": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "RateLimiterPolicy": "auth-policy",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "google-signin-callback-route": {
        "ClusterId": "user-cluster",
        "RateLimiterPolicy": "auth-policy",
        "Match": { "Path": "/signin-google" }
      },
      "notes-route": {
        "ClusterId": "notes-cluster",
        "RateLimiterPolicy": "notes-policy",
        "Match": { "Path": "/api/notes/{**catch-all}" }
      },
      "labels-route": {
        "ClusterId": "notes-cluster",
        "RateLimiterPolicy": "notes-policy",
        "Match": { "Path": "/api/labels/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "user-api": { "Address": "https://localhost:7001/" }
        }
      },
      "notes-cluster": {
        "Destinations": {
          "notes-api": { "Address": "https://localhost:7002/" }
        }
      }
    }
  }
}
